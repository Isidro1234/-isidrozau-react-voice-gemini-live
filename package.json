{
  "name": "@isidrozau/react-voice-gemini-live-realtime",
  "version": "1.1.5",
  "description": "browser voice control system powered by gemini live api, easily integrate ai voice assistant with access to tools on your web app, custom function calls, coupled with pre-build tools for dom manipulation",
  "keywords": [
    "ai",
    "assistant",
    "bvc",
    "ai",
    "agent",
    "react",
    "ai",
    "agent",
    "react",
    "gemini",
    "live",
    "api"
  ],
  "license": "ISC",
  "author": "isidoro zau",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isidro1234/-isidrozau-react-voice-gemini-live"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "snippet": "./dist/bin/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "rollup": "rollup -c --bundleConfigAsCjs"
  },
